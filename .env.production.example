# ─────────────────────────────────────────────────────────────────────────
# Lumina Library — PRODUCTION environment template.
#
# Copy this to `.env` on the VPS (NOT into git) and fill in every blank
# value before running scripts/deploy.sh. See docs/deployment.md for the
# full walkthrough.
#
# Service hostnames below (mysql/redis/app/reverb) are the Docker Compose
# service names in docker-compose.yml — they resolve via Docker's internal
# DNS on the `internal` network and must NOT be changed unless you also
# rename the corresponding service.
# ─────────────────────────────────────────────────────────────────────────

# ── Container images (GHCR) ──────────────────────────────────────────────
# Set these to the images published by .github/workflows/docker-publish.yml
# so the VPS PULLS them instead of building from source. Replace OWNER with
# your GitHub username/org in LOWERCASE. Then deploy with
# `LUMINA_PULL_IMAGES=true ./scripts/update.sh` (the CI does this for you).
APP_IMAGE=ghcr.io/OWNER/lumina-library-app:latest
NGINX_IMAGE=ghcr.io/OWNER/lumina-library-nginx:latest

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="Lumina Library"
APP_ENV=production
APP_KEY=                      # Generate locally: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://lumina.rmtemplate.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────
# stderr -> captured by `docker compose logs` / your VPS's Docker log
# driver. Never write application logs to the container filesystem.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL) ─────────────────────────────────────────────────────
# Set DB_HOST to the `mysql` service name to use the bundled container, or
# to an external host/IP if you're pointing at an already-managed database
# (in which case also remove the `mysql` service from docker-compose.yml).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lumina_library
DB_USERNAME=lumina_app
DB_PASSWORD=                  # Strong, unique password
DB_ROOT_PASSWORD=             # Only used by the `mysql` container itself (root account)

# ── Session / Cache / Queue (Redis-backed in production) ────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.rmtemplate.com

CACHE_STORE=redis
CACHE_PREFIX=lumina_cache

QUEUE_CONNECTION=redis

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                # Strong, unique password — required (see docker/redis/redis.conf)
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Filesystem ────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Mail ──────────────────────────────────────────────────────────────────
# Any free/open SMTP relay works (e.g. your domain's own mailbox, or a
# free-tier transactional sender) — nothing here requires a paid service.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@rmtemplate.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcasting / Realtime (Laravel Reverb — free, self-hosted) ────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Advertised host/port/scheme — what BOTH the Laravel app (server-side
# publish) and Flutter clients connect to. Must be the public domain that
# routes through Nginx -> the `nginx` container's /app|/apps proxy (see
# docker/nginx/conf.d/app.conf) -> the `reverb` container. NOT a Docker
# service name — this is reached from the public internet too.
REVERB_HOST=lumina.rmtemplate.com
REVERB_PORT=443
REVERB_SCHEME=https

# Bind address inside the `reverb` container — 0.0.0.0 so Nginx (a
# different container) can reach it at all. Do not change.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# ── Nginx ─────────────────────────────────────────────────────────────────
# Host port the `nginx` container publishes — keep at 80 if a reverse
# proxy (Nginx Proxy Manager / Cloudflare Tunnel) sits in front of it on
# the same VPS. See "SSL" in docs/deployment.md.
NGINX_HTTP_PORT=80

# ── Midtrans Payment Gateway (Core API) ──────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SANITIZED=true
MIDTRANS_3DS=true
MIDTRANS_PAYMENT_EXPIRY_MINUTES=60
MIDTRANS_NOTIFICATION_URL="${APP_URL}/api/v1/payments/webhook"
MIDTRANS_FINISH_REDIRECT_URL=

# ── Borrowing lifecycle ───────────────────────────────────────────────────
BORROWING_MAX_DAYS=7
BORROWING_FINE_PER_DAY=5000
PICKUP_EXPIRE_DAYS=3
PICKUP_NOSHOW_FEE=10000
PICKUP_EXPIRED_AFTER_HOURS=24

# ── QR Code signing ───────────────────────────────────────────────────────
QR_ISSUER=lumina-library
QR_AUDIENCE=lumina-mobile-app
QR_SIGNING_SECRET=            # Long random string — treat like a secondary APP_KEY
QR_PICKUP_TTL_SECONDS=600
QR_RETURN_TTL_SECONDS=600

# ── Bypass flags — NEVER true in production ──────────────────────────────
APP_ENABLE_STAFF_BYPASS=false
APP_ENABLE_DEV_BYPASS=false
