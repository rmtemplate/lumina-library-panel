APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Broadcasting / Realtime (Laravel Reverb)
#
# For local development with a physical mobile device on the same WiFi,
# set APP_URL and REVERB_HOST to your machine's LAN IP (e.g. 192.168.1.50),
# NOT localhost/127.0.0.1 — the device can't reach your machine via those.
# Find your IP: `ipconfig` (Windows) / `ifconfig` or `ip a` (Mac/Linux).
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Advertised host — what Laravel (publishing) and clients (connecting)
# both use. Must be a real reachable IP/hostname, never 0.0.0.0.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Bind address for `php artisan reverb:start`. 0.0.0.0 = listen on all
# network interfaces — required for LAN devices to connect at all.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"

# Midtrans Payment Gateway — Core API (charge), not Snap. See docs/midtrans.md.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SANITIZED=true
MIDTRANS_3DS=true
MIDTRANS_PAYMENT_EXPIRY_MINUTES=60
MIDTRANS_NOTIFICATION_URL="${APP_URL}/api/v1/payments/webhook"
MIDTRANS_FINISH_REDIRECT_URL=

# Borrowing lifecycle (see docs/borrowing-lifecycle.md)
BORROWING_MAX_DAYS=7
BORROWING_FINE_PER_DAY=5000
PICKUP_EXPIRE_DAYS=3
PICKUP_NOSHOW_FEE=10000

# QR Code Config
QR_ISSUER=lumina-library
QR_AUDIENCE=lumina-mobile-app
QR_SIGNING_SECRET=
QR_PICKUP_TTL_SECONDS=120
QR_RETURN_TTL_SECONDS=120

# How long an awaiting_pickup borrowing stays reservable before auto-expiring.
# Can also be overridden at runtime via the `reservation_hold_hours` AppSetting.
PICKUP_EXPIRED_AFTER_HOURS=24

# Allows staff to confirm pickup without scanning a QR (dev/testing/emergency
# override). Keep false in production unless explicitly required.
APP_ENABLE_STAFF_BYPASS=false

# UNAUTHENTICATED, LOCAL-ONLY pickup bypass for single-device testing.
# Already allowed when APP_ENV=local or APP_DEBUG=true — this flag is only
# needed if you want it enabled in some other environment. NEVER set true
# in production.
APP_ENABLE_DEV_BYPASS=false
